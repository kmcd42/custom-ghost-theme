{{!< default}}

{{#author}}
<div class="wrap section masthead">
    <div class="eyebrow masthead__eyebrow">Author</div>
    <h1 class="masthead__title">{{name}}</h1>
    {{#if bio}}<p class="about__lede" style="margin-top:18px">{{bio}}</p>{{/if}}
</div>
{{/author}}

<div class="wrap section post-index">
    {{#foreach posts}}{{> "post-row"}}{{/foreach}}
</div>

<div class="wrap">{{pagination}}</div>
