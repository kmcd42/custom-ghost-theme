{{!< default}}

{{!-- Photography index: a gallery of photo collections (one post = one set) --}}
<div class="wrap section photo-head">
    <div>
        <div class="eyebrow">Shot around the motu</div>
        <h1 class="photo-head__title">Photography</h1>
    </div>
    <div class="filter-row">
        <a class="filter-chip is-active" href="{{@site.url}}/photography/">All</a>
        {{#get "tags" filter="visibility:public" limit="4"}}
            {{#foreach tags}}<a class="filter-chip" href="{{url}}">{{name}}</a>{{/foreach}}
        {{/get}}
    </div>
</div>

<div class="wrap section">
    <div class="collection-grid">
        {{#foreach posts}}
            <a class="collection-card" href="{{url}}" aria-label="{{title}}">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="l"}}"
                         srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
                         sizes="(max-width: 768px) 100vw, 50vw"
                         alt="{{title}}" loading="lazy" />
                {{/if}}
                <div class="collection-card__overlay">
                    <div class="collection-card__title">{{title}}</div>
                    <div class="collection-card__meta">{{#if primary_tag}}{{primary_tag.name}}{{/if}}{{#if published_at}} · {{date format="YYYY"}}{{/if}}</div>
                </div>
            </a>
        {{/foreach}}
    </div>
    {{pagination}}
</div>
