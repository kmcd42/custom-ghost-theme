{{!-- A gallery tile --}}
<a class="photo-tile" href="{{url}}" aria-label="{{title}}">
    {{#if feature_image}}
        <img src="{{img_url feature_image size="m"}}"
             srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w"
             sizes="(max-width: 768px) 50vw, 33vw"
             alt="{{title}}" loading="lazy" />
    {{/if}}
</a>
