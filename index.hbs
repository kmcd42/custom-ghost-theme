{{!< default}}
{{!--
    HOMEPAGE — The Portfolio
    Boldly photographic: a compact greeting, then the work itself.
    Portfolio and photography posts flow together in a full-width
    masonry of uncropped images — the first piece leads at full bleed.
    Writing, the Now pulse and the newsletter live in a quiet strip
    at the end.
--}}

<div class="home-folio">

    {{!-- 1. Greeting — small, then get out of the way of the work --}}
    <header class="folio-intro">
        <p class="folio-kicker">Kia ora — I'm Kasey</p>
        {{#if @site.description}}
            <h1 class="folio-statement">{{@site.description}}</h1>
        {{else}}
            <h1 class="folio-statement">{{@site.title}}</h1>
        {{/if}}
        <p class="folio-meta">Designer, writer &amp; marketer in Wellington, Aotearoa.</p>
    </header>

    {{!-- 2. The work — portfolio and photography, images at natural ratios --}}
    <section class="folio-grid" aria-label="Selected work and photography">
        {{#get "posts" filter="tag:[portfolio,photography]" limit="15" include="tags" order="published_at desc"}}
            {{#foreach posts}}
                {{#if feature_image}}
                <a href="{{url}}" class="folio-item{{#if @first}} folio-lead{{/if}} reveal-on-scroll">
                    <span class="folio-item-frame">
                        <img
                            srcset="{{img_url feature_image size="m"}} 720w,
                                    {{img_url feature_image size="l"}} 1200w,
                                    {{img_url feature_image size="xl"}} 2000w"
                            sizes="{{#if @first}}100vw{{else}}(max-width: 700px) 100vw, 50vw{{/if}}"
                            src="{{img_url feature_image size="l"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                            loading="{{#if @first}}eager{{else}}lazy{{/if}}"
                        />
                    </span>
                    <span class="folio-item-caption">
                        {{#if primary_tag}}
                            <span class="folio-item-tag">{{primary_tag.name}}</span>
                        {{/if}}
                        <span class="folio-item-title">{{title}}</span>
                    </span>
                </a>
                {{/if}}
            {{else}}
                <p class="folio-empty">Work is on its way — tag posts with <code>portfolio</code> or <code>photography</code> and they'll appear here.</p>
            {{/foreach}}
        {{/get}}
    </section>

    <div class="folio-grid-more">
        <a href="/portfolio/" class="folio-more-link">All work
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/photography/" class="folio-more-link">All photography
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>

    {{!-- 3. The quiet strip — everything that isn't the work --}}
    <div class="folio-after">

        {{!-- Right now — live pulse from the Now page --}}
        {{#get "pages" filter="slug:now" limit="1"}}
            {{#foreach pages}}
            <a href="{{url}}" class="home-now reveal-on-scroll">
                <span class="home-now-dot" aria-hidden="true"></span>
                <span class="home-now-body">
                    <span class="home-now-label">Right now</span>
                    <span class="home-now-excerpt">{{excerpt words="36"}}&hellip;</span>
                    <span class="home-now-updated">Updated {{date updated_at timeago="true"}}</span>
                </span>
                <span class="home-now-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
            </a>
            {{/foreach}}
        {{/get}}

        <div class="folio-columns reveal-on-scroll">
            {{!-- Writing — compact index --}}
            <section class="folio-writing">
                <h2 class="folio-column-title">Writing</h2>
                {{#get "posts" filter="tag:-portfolio+tag:-photography" limit="3"}}
                    {{#foreach posts}}
                        <a href="{{url}}" class="folio-post-link">
                            <span class="folio-post-title">{{title}}</span>
                            <time class="folio-post-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM YYYY"}}</time>
                        </a>
                    {{else}}
                        <p class="folio-empty-note">New essays are brewing.</p>
                    {{/foreach}}
                {{/get}}
                <a href="/blog/" class="folio-small-link">All writing &rarr;</a>
            </section>

            {{!-- Elsewhere — the newsletter and the site's corners --}}
            <section class="folio-elsewhere">
                <h2 class="folio-column-title">Elsewhere</h2>
                <a href="https://threesixtysix.news" target="_blank" rel="noopener" class="folio-post-link">
                    <span class="folio-post-title">threesixtysix</span>
                    <span class="folio-post-date">Climate newsletter</span>
                </a>
                <a href="/about/" class="folio-post-link">
                    <span class="folio-post-title">About</span>
                    <span class="folio-post-date">Bio &amp; work history</span>
                </a>
                <a href="/colophon/" class="folio-post-link">
                    <span class="folio-post-title">Colophon</span>
                    <span class="folio-post-date">How this site is made</span>
                </a>
                <a href="{{@site.url}}/rss/" class="folio-post-link">
                    <span class="folio-post-title">RSS</span>
                    <span class="folio-post-date">The open web</span>
                </a>
            </section>
        </div>

        {{!-- Subscribe --}}
        {{#if @site.members_enabled}}
        <section class="home-subscribe reveal-on-scroll">
            <div class="home-subscribe-content">
                <h2 class="home-subscribe-title">Stay curious</h2>
                <p class="home-subscribe-desc">Occasional notes when there's new work and writing. No spam, just genuine sharing.</p>
                <a href="#/portal/signup" class="home-subscribe-btn" data-portal="signup">
                    <span>Subscribe</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </section>
        {{/if}}

    </div>
</div>
