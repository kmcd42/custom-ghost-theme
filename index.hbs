{{!< default}}

{{!-- Generic fallback index (archives without a dedicated template) --}}
<div class="wrap section masthead">
    <h1 class="masthead__title">{{#if @site.title}}{{@site.title}}{{else}}Latest{{/if}}</h1>
</div>

<div class="wrap section post-index">
    {{#foreach posts}}{{> "post-row"}}{{/foreach}}
</div>

<div class="wrap">{{pagination}}</div>
