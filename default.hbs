<!DOCTYPE html>
<html lang="{{@site.locale}}" class="{{#match @custom.default_theme "Light"}}theme-light{{else}}theme-dark{{/match}}">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{{meta_title}}</title>
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    {{!-- Browser chrome colour --}}
    <meta name="theme-color" content="{{#match @custom.default_theme "Light"}}#FFFCF1{{else}}#060809{{/match}}" />

    {{!-- Fonts: Instrument Serif · Inter · JetBrains Mono (non-blocking) --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"></noscript>

    {{!-- Styles --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />

    {{!-- Accent colour from Design settings --}}
    {{#if @custom.accent_color}}
    <style>:root { --accent: {{@custom.accent_color}}; }</style>
    {{/if}}

    {{ghost_head}}
</head>

<body class="{{body_class}}
    {{#if @custom.enable_grain}}has-grain{{/if}}
    {{#if @custom.enable_glow}}has-glow{{/if}}
    {{#if @custom.enable_magnetic}}has-magnetic{{/if}}">

<a href="#site-main" class="skip-link">Skip to content</a>

<div class="site">
    {{#if @custom.enable_glow}}<div class="fx-glow" aria-hidden="true"></div>{{/if}}

    {{> "header"}}

    <main id="site-main" class="site-main">
        {{{body}}}
    </main>

    {{> "footer"}}
</div>

{{> "mobile-menu"}}

{{#if @custom.enable_grain}}<div class="fx-grain" aria-hidden="true"></div>{{/if}}

<script src="{{asset "built/main.min.js"}}"></script>
{{ghost_foot}}
</body>
</html>
