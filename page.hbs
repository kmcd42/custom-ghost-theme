{{!< default}}

{{!-- Generic page: Now, Colophon, and any other Ghost page.
     About uses page-about.hbs (auto-selected by slug). --}}
{{#post}}
<article class="wrap section page-article">
    {{#if @page.show_title_and_feature_image}}
        <header class="page-masthead">
            {{#if primary_tag}}<div class="eyebrow page-masthead__eyebrow">{{primary_tag.name}}</div>{{/if}}
            <h1 class="page-masthead__title">{{title}}</h1>
        </header>

        {{#if feature_image}}
            <div class="page-feature"><img src="{{img_url feature_image size="xl"}}" alt="{{title}}" /></div>
        {{/if}}
    {{/if}}

    <div class="page-body gh-content">{{content}}</div>

    <div class="page-updated">Updated {{date updated_at format="MMMM YYYY"}}</div>
</article>
{{/post}}
