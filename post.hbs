{{!< default}}

{{#post}}
{{#has tag="hash-work"}}
    {{!-- ── Case study ─────────────────────────────────────────── --}}
    <article class="wrap section case">
        <div class="case__eyebrow">{{tags separator=" · " limit="3" autolink="false"}}</div>
        <h1 class="case__title">{{title}}</h1>

        {{#if feature_image}}
            <img class="case__hero" src="{{img_url feature_image size="xl"}}" alt="{{title}}" />
        {{/if}}

        <div class="case__body">
            <div class="case__meta">
                {{#if primary_tag}}
                <div class="meta-item">
                    <div class="meta-label">Discipline</div>
                    <div class="meta-value">{{primary_tag.name}}</div>
                </div>
                {{/if}}
                <div class="meta-item">
                    <div class="meta-label">Year</div>
                    <div class="meta-value">{{date format="YYYY"}}</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Services</div>
                    <div class="meta-value">{{tags separator=", " autolink="false"}}</div>
                </div>
            </div>

            <div class="case__prose">
                {{#if custom_excerpt}}<p class="case__lead">{{custom_excerpt}}</p>{{/if}}
                <div class="gh-content">{{content}}</div>
            </div>
        </div>

        {{#next_post in="primary_tag"}}
            <a class="index-cta" href="{{url}}" style="margin-top:40px">Next project: {{title}} &rarr;</a>
        {{/next_post}}
    </article>

{{else}}
{{#has tag="hash-role"}}
    {{!-- ── Role / experience detail ───────────────────────────── --}}
    <article class="wrap section role-page">
        <a class="back-link" href="{{@site.url}}/about/">&larr; About</a>
        <header class="role-header">
            <div class="eyebrow">Experience</div>
            <h1 class="case__title">{{title}}</h1>
        </header>

        <div class="case__body">
            <div class="case__meta">
                {{#if custom_excerpt}}
                <div class="meta-item">
                    <div class="meta-label">Employer</div>
                    <div class="meta-value">{{custom_excerpt}}</div>
                </div>
                {{/if}}
                {{#if primary_tag}}
                <div class="meta-item">
                    <div class="meta-label">Period</div>
                    <div class="meta-value">{{primary_tag.name}}</div>
                </div>
                {{/if}}
            </div>

            <div class="case__prose">
                <div class="gh-content">{{content}}</div>
            </div>
        </div>
    </article>

{{else}}
{{#has tag="hash-photo"}}
    {{!-- ── Photography collection ─────────────────────────────── --}}
    <article class="wrap section photo-collection">
        <a class="back-link" href="{{@site.url}}/photography/">&larr; Photography</a>

        <header class="collection-header">
            <div class="eyebrow">{{#if primary_tag}}{{primary_tag.name}}{{else}}Photography{{/if}}{{#if published_at}} · {{date format="YYYY"}}{{/if}}</div>
            <h1 class="collection-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="collection-dek">{{custom_excerpt}}</p>{{/if}}
        </header>

        <div class="gh-content gh-content--gallery">{{content}}</div>

        <div class="collection-foot">
            {{#prev_post in="primary_tag"}}<a class="back-link" href="{{url}}">&larr; Previous set</a>{{/prev_post}}
            {{#next_post in="primary_tag"}}<a class="back-link" href="{{url}}">Next set &rarr;</a>{{/next_post}}
        </div>
    </article>

{{else}}
    {{!-- ── Article ────────────────────────────────────────────── --}}
    <article class="wrap section article">
        <header class="article__header">
            <div class="article__eyebrow">{{#if primary_tag}}{{primary_tag.name}} · {{/if}}{{date format="D MMMM YYYY"}} · {{reading_time}}</div>
            <h1 class="article__title">{{title}}</h1>
            {{#if custom_excerpt}}<div class="article__dek">{{custom_excerpt}}</div>{{/if}}
        </header>

        {{#if feature_image}}
            <div class="article__feature"><img src="{{img_url feature_image size="xl"}}" alt="{{title}}" /></div>
        {{/if}}

        <div class="article__body gh-content has-dropcap">{{content}}</div>

        {{#next_post}}
            <div class="wrap" style="max-width:var(--measure);margin-inline:auto;">
                <a class="index-cta" href="{{url}}">Next: {{title}} &rarr;</a>
            </div>
        {{/next_post}}
    </article>
{{/has}}
{{/has}}
{{/has}}
{{/post}}
